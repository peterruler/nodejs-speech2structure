{
  "name": "nodejs-speech2structure",
  "version": "2.0.0",
  "private": true,
  "description": "Strictly typed medical audio extraction with Next.js, Node.js and Zod",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "next": "16.3.8",
    "openai": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "license": "MIT"
}
